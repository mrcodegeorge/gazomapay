# Gazoma Pay Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL

APP_ENV=local
APP_NAME="Gazoma Pay"
APP_URL=http://localhost:8000
GAZOMA_PAYMENT_MODE=sandbox

# Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gazoma_pay
DB_USERNAME=root
DB_PASSWORD=

# Paystack Payment Provider Configuration
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Hubtel Mobile Money Payment Provider Configuration
HUBTEL_ENABLED=false
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret

# Webhook Secrets
GAZOMA_WEBHOOK_SECRET=whsec_9a8b7c6d5e4f3a2b1c
